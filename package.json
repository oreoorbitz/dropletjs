{
  "name": "@oreoorbitz/dropletjs",
  "version": "1.0.0",
  "author": "oreoorbitz",
  "description": "A high-performance, synchronous-only fork of LiquidJS \u2014 2-4x faster rendering with zero async overhead",
  "main": "dist/droplet.cjs.js",
  "module": "dist/droplet.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=14"
  },
  "license": "MIT",
  "keywords": [
    "liquid",
    "template",
    "engine",
    "fast",
    "synchronous",
    "liquidjs-fork"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oreoorbitz/dropletjs",
    "homepage": "https://github.com/oreoorbitz/dropletjs#readme",
    "bugs": {
      "url": "https://github.com/oreoorbitz/dropletjs/issues"
    }
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=es2017 --format=cjs --outfile=dist/droplet.cjs.js --external:tslib",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --target=es2017 --format=esm --outfile=dist/droplet.mjs --external:tslib",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^20.0.0",
    "@types/node": "^22.3.0",
    "@types/sinon": "^10.0.13",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.20.2",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "jsdom": "^24.1.0",
    "sinon": "^15.0.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^4.9.5"
  }
}
